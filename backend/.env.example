# Copia este archivo como backend/.env y completa los valores. El archivo .env no se sube al repositorio.

# ==================== CONFIGURACIÓN GENERAL ====================
PORT=5000
NODE_ENV=development

# ==================== BASE DE DATOS ====================
DB_HOST=localhost
DB_PORT=5433
DB_NAME=BD_gessenapp
DB_USER=postgres
DB_PASSWORD=escribe_aqui_la_contraseña_de_postgres

# ==================== JWT ====================
# Cadena larga y aleatoria; por ejemplo: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=escribe_aqui_una_clave_larga_y_aleatoria

# ==================== OTROS ====================
CORS_ORIGIN=http://localhost:3000
